# https://flake8.pycqa.org/en/latest/user/configuration.html
[flake8]
max-line-length = 80
per-file-ignores =
    # E501: line too long
    tests/test_git_superproject.py: E501,
    # IMR241: When using the from syntax, only submodules are imported, not module elements.
    # NB: Do not add any more here.
    command.py: IMR241,
    git_status.py: IMR241,
    main.py: IMR241,
    manifest_xml.py: IMR241,
    subcmds/gc.py: IMR241,
    subcmds/rebase.py: IMR241,
    subcmds/selfupdate.py: IMR241,
    subcmds/smartsync.py: IMR241,
    subcmds/sync.py: IMR241,
    subcmds/upload.py: IMR241,
    subcmds/wipe.py: IMR241,
    tests/e2e/test_failures.py: IMR241,
    tests/e2e/test_groups.py: IMR241,
    tests/e2e/test_init_sync.py: IMR241,
    tests/e2e/test_manifest_regressions.py: IMR241,
    tests/e2e/test_partial_clone.py: IMR241,
    tests/e2e/test_sync_modes.py: IMR241,
    tests/e2e/test_workflows.py: IMR241,
    tests/test_subcmds_sync.py: IMR241,
extend-ignore =
    # B042: Exception class with __init__ should pass all args to super().__init__()
    # We should fix this by reworking our exception classes.
    B042,
    # E203: Whitespace before ':'
    # See https://github.com/PyCQA/pycodestyle/issues/373
    E203,
    # E402: Module level import not at top of file
    E402,
    # E731: do not assign a lambda expression, use a def
    E731,
exclude =
    .venv,
    venv,
    .tox,
# IMR241: When using the from syntax, only submodules are imported, not module elements.
# NB: Do not add more modules here without strong discussion.  This is aligned
# with Google's Python style guide.
imr241_exclude =
    collections.abc,
    pathlib,
    typing,
    typing_extensions,
